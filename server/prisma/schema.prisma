generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// An account. Signs in with a password, Google, or both.
model User {
  id                     String    @id @default(cuid())
  email                  String    @unique
  fullName               String
  /// Null for a Google-only account.
  passwordHash           String?
  googleId               String?   @unique
  avatarUrl              String?
  /// Set when the inbox was proven: Google vouched for it, or the owner opened an emailed link.
  /// A password account cannot sign in until it is set.
  emailVerifiedAt        DateTime?
  emailVerifyTokenHash   String?   @unique
  emailVerifyExpiresAt   DateTime?
  /// Bumped when the password changes; every older session cookie stops being honoured.
  tokenVersion           Int       @default(0)
  passwordResetTokenHash String?   @unique
  passwordResetExpiresAt DateTime?
  /// Spendable credits: the running sum of `CreditEntry.delta`, kept here so a charge is one
  /// conditional update (`credits >= price`). Never negative.
  credits                Int       @default(0)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  creditEntries CreditEntry[]
  payments      Payment[]
  plays         PuzzlePlay[]
}

enum CreditReason {
  /// A paid credit pack.
  purchase
  /// A puzzle built.
  generation
  /// A refund or chargeback taking a pack's credits back.
  refund
}

/// Append-only: every change to a balance, with the balance after it. Never updated or deleted.
model CreditEntry {
  id           String       @id @default(uuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id])
  delta        Int
  balanceAfter Int
  reason       CreditReason
  /// `generation`: the puzzle it paid for.
  puzzleId     String?
  /// `purchase` and `refund`: the Paddle transaction (`txn_…`).
  paymentId    String?
  /// `refund`: the Paddle adjustment (`adj_…`) — unique, so one is applied once.
  adjustmentId String?      @unique
  createdAt    DateTime     @default(now())

  @@index([userId, createdAt])
  @@index([paymentId])
}

enum PaymentStatus {
  /// Checkout opened, not paid (yet).
  pending
  completed
  /// A payment attempt was declined; the customer may still retry in the same checkout.
  failed
  /// Fully refunded or charged back.
  refunded
}

/// One Paddle transaction for one credit pack — created when the checkout opens, completed by
/// the webhook. The webhook trusts this row (who, which pack), not the payload's `custom_data`.
model Payment {
  /// The Paddle transaction id (`txn_…`).
  id              String        @id
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  pack            String
  priceId         String
  credits         Int
  status          PaymentStatus @default(pending)
  /// Paddle's totals from the completed transaction, in the currency's lowest unit (cents).
  currency        String?
  /// What the customer paid, tax included.
  total           Int?
  tax             Int?
  /// Paddle's fee.
  fee             Int?
  /// What is left for us, in `currency`.
  earnings        Int?
  /// `earnings` converted to the payout currency — the number to sum across currencies.
  payoutCurrency  String?
  payoutEarnings  Int?
  paymentMethod   String?
  customerId      String?
  /// Credits taken back by refunds and chargebacks.
  refundedCredits Int           @default(0)
  completedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

/// Every verified Paddle webhook, stored raw before it is handled: the audit trail, and a
/// redelivered event (same `event_id`) is handled once.
model PaymentEvent {
  /// Paddle's `event_id` (`evt_…`).
  id            String    @id
  type          String
  transactionId String?
  occurredAt    DateTime
  payload       Json
  /// Null until handled; a failed handling answers 500 and Paddle redelivers.
  processedAt   DateTime?
  receivedAt    DateTime  @default(now())

  @@index([transactionId])
  @@index([type, receivedAt])
}

/// A free monthly puzzle claimed — one per (month, holder). `holder` is `user:<id>` or
/// `guest:<id>` (an httpOnly cookie the API sets).
model FreeSpend {
  id        String   @id @default(uuid())
  /// UTC calendar month, `2026-11`.
  month     String
  /// `user:<id>` or `guest:<id>`: whose monthly free credits these were.
  holder    String
  /// A hash of the IP: caps how many guest devices one address may spend free credits from in a month.
  ipKey     String
  puzzleId  String
  /// The free credits this puzzle took. A holder's month adds up to at most FREE_MONTHLY_CREDITS.
  amount    Int
  createdAt DateTime @default(now())

  @@index([month, holder])
  @@index([month, ipKey])
  // The hourly cap on free credits counts the spends of the last hour (`services/billing.ts`).
  @@index([createdAt])
}

enum PuzzleFormat {
  classic
  scanword
}

enum EntryOrigin {
  ai
  /// Hand-written and hand-checked (`prisma/seed/entries.<locale>.json`): reports never retire it.
  seed
  /// Written by Claude agents in development (`prisma/seed/claude/<locale>/*.json`): retired by reports like `ai`.
  claude
}

/// Proper nouns are fair answers only in the topics about them (geography, local culture).
enum EntryKind {
  common
  proper
}

/// `full` clues go in the classic Across/Down lists; `short` ones fit inside a scanword cell.
enum ClueStyle {
  full
  short
}

/// One answer word of one language. The id *is* the word's identity: devices keep the ids
/// they were shown and exclude them, so an answer never comes back — not even with a new clue.
/// **Never delete a row** — retire it. A deleted word could be generated again under a new id
/// and slip past every device's seen-list.
model Entry {
  id           Int         @id @default(autoincrement())
  locale       String
  /// Normalized cell string (`lib/alphabet.ts`): lowercase, `ё` folded, no stress marks.
  answer       String
  /// As the language writes it, for reports and admin views: "ёлка", "Երևան".
  display      String
  /// In cells, not code units — Armenian `ու` is one cell.
  length       Int
  /// The first cell token; generation spreads its starting letters with it.
  firstCell    String
  /// Merged when the same word is generated under another topic.
  topics       String[]
  /// 1 everyday … 3 rare.
  difficulty   Int
  kind         EntryKind   @default(common)
  origin       EntryOrigin @default(ai)
  model        String?
  /// Placed in a stored puzzle — not merely drawn as a candidate.
  servedCount  Int         @default(0)
  /// Reveals reported by solvers: a word revealed often is harder than its label says.
  revealCount  Int         @default(0)
  reportCount  Int         @default(0)
  retiredAt    DateTime?
  /// Held for the daily crossword: custom puzzles never draw it. Cleared when a daily places it.
  dailyReserve Boolean     @default(false)
  createdAt    DateTime    @default(now())

  clues   Clue[]
  reports EntryReport[]

  @@unique([locale, answer])
  @@index([locale, dailyReserve])
  @@index([locale, difficulty, length])
  @@index([locale, firstCell])
  @@index([topics], type: Gin)
}

model Clue {
  id          String    @id @default(uuid())
  entryId     Int
  entry       Entry     @relation(fields: [entryId], references: [id], onDelete: Cascade)
  style       ClueStyle
  text        String
  /// Normalized text, so a reworded duplicate of the same clue collides.
  hash        String
  /// 1 a direct definition … 3 oblique.
  difficulty  Int
  /// Passed the judge pass (`services/entryGen.ts`); seed clues are hand-checked.
  verified    Boolean   @default(false)
  servedCount Int       @default(0)
  reportCount Int       @default(0)
  retiredAt   DateTime?
  model       String?
  createdAt   DateTime  @default(now())

  @@unique([entryId, hash])
  @@index([entryId, style])
}

/// An immutable snapshot: retiring or rewording a clue never changes a puzzle someone shared.
model Puzzle {
  /// 10 base62 characters — short enough for a link, too many to guess.
  id            String       @id
  locale        String
  format        PuzzleFormat
  topic         String
  difficulty    Int
  size          String
  width         Int
  height        Int
  seed          Int
  /// `LAYOUT_VERSION` of the engine that built it.
  layoutVersion Int
  /// The `PuzzleView` minus `id` and `createdAt`.
  data          Json
  entryIds      Int[]
  clueIds       String[]
  playCount     Int          @default(0)
  solveCount    Int          @default(0)
  createdAt     DateTime     @default(now())

  plays PuzzlePlay[]
  daily DailyPuzzle?

  @@index([locale, createdAt])
}

/// A puzzle a signed-in player was shown, and how each of its words went. The account's
/// seen-list: every word of its puzzles in a language is left out of the next one, on any device.
model PuzzlePlay {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  puzzleId  String
  puzzle    Puzzle   @relation(fields: [puzzleId], references: [id])
  /// The puzzle's, kept here so a player's seen words in one language are one index range.
  locale    String
  /// One byte per word, in the puzzle's word order: an index into `WORD_STATES`.
  states    Bytes
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([userId, puzzleId])
  @@index([userId, locale])
}

model EntryReport {
  id          String   @id @default(uuid())
  entryId     Int
  entry       Entry    @relation(fields: [entryId], references: [id], onDelete: Cascade)
  clueId      String?
  puzzleId    String?
  /// A hash of the reporter's IP — enough to stop one person retiring a clue alone.
  reporterKey String
  reason      String
  /// The player's own words, only when `reason` is `other`.
  note        String?
  createdAt   DateTime @default(now())

  @@unique([entryId, reporterKey])
}

/// Where the pool will run short: the only thing that makes the refill job call Gemini. After a
/// puzzle is built, the builder checks whether the same request again could be filled with words
/// that player has not seen; when not, the gap is recorded here (`services/entryPool.ts`).
model PoolDemand {
  locale          String
  /// A topic, or `any` (refilled one topic at a time, the thinnest first).
  topic           String
  difficulty      Int
  requests        Int       @default(0)
  /// New words the bucket needs: the largest gap any player's next puzzle would hit (not the sum —
  /// a new word is unseen by everyone). 0 when nothing is needed.
  shortfall       Int       @default(0)
  /// A paying player's gap (or the daily's): refilled before free play's, from the whole budget.
  paid            Boolean   @default(false)
  /// The length band that ran out (`short` ≤ 5 cells, `mid` 6–8, `long` 9+); generation leans on it.
  lengthBand      String?
  /// Generation stopped finding new words here: no Gemini call before this.
  pausedUntil     DateTime?
  lastRequestedAt DateTime  @default(now())

  @@id([locale, topic, difficulty])
  @@index([shortfall])
}

/// The daily crossword: one puzzle per language per UTC day, the same for everyone. Built a day
/// ahead from the daily reserve (`services/daily.ts`).
model DailyPuzzle {
  locale    String
  /// The UTC day, `YYYY-MM-DD`.
  date      String
  puzzleId  String   @unique
  puzzle    Puzzle   @relation(fields: [puzzleId], references: [id])
  createdAt DateTime @default(now())

  @@id([locale, date])
}

/// One row per Gemini generation call: spreads subtopics and starting letters, caps the daily
/// budget, and shows when a slice of vocabulary is running dry (`inserted` falling behind `valid`).
model GenerationLog {
  id            String   @id @default(uuid())
  locale        String
  topic         String
  subtopic      String
  difficulty    Int
  letters       String[]
  model         String
  promptVariant String
  /// Gemini calls this generation cost, the judge pass included.
  calls         Int      @default(1)
  /// Tokens billed for those calls. `outputTokens` excludes `thoughtTokens`; both bill as output.
  promptTokens  Int      @default(0)
  cachedTokens  Int      @default(0)
  outputTokens  Int      @default(0)
  thoughtTokens Int      @default(0)
  returned      Int
  valid         Int
  verified      Int
  inserted      Int
  mergedClues   Int
  ms            Int
  createdAt     DateTime @default(now())

  @@index([locale, topic, createdAt])
  @@index([createdAt])
}

# =============================================================================
# Crossword API. One file per environment, both git-ignored:
#   server/.env.development.local   local dev — `pnpm dev`, `db:*`, Prisma (the default)
#   server/.env.production.local    production — part A only, encoded by `pnpm env:base64 production`
# The server loads server/.env.<NODE_ENV>.local, so NODE_ENV picks the file.
#   A. Secrets and per-environment URLs — production keeps these in a secret.
#   B. Runtime topology (bottom) — local dev only; the deploy sets these.
# =============================================================================

# --- A ----------------------------------------------------------------------

# Postgres from docker-compose.yml (host port 5007).
#   dev:   postgresql://crossword:crossword@localhost:5007/crossword?schema=public
#   prod:  postgresql://crossword:<hex-password>@127.0.0.1:5007/crossword?schema=public
DATABASE_URL="postgresql://crossword:crossword@localhost:5007/crossword?schema=public"

# The exact origin serving the web app, no trailing slash. requireSameOrigin compares
# against it. Production: https://<your domain>
CORS_ORIGIN="http://localhost:7007"

# --- Gemini ---------------------------------------------------------------
# A free key from https://aistudio.google.com/apikey. Read only by src/lib/gemini.ts.
# Empty disables generation: puzzles are built from the seeded pool only.
GEMINI_KEY=""
# Comma-separated model chain, cheapest first. Free-tier quotas are per model, so a
# longer chain is more capacity. Each item is name[:thinkingLevel].
# GEMINI_MODELS="gemini-3.5-flash-lite:MINIMAL,gemini-3.6-flash:LOW,gemini-3.8-flash:LOW"
# A second "judge" pass on every generated batch (one cheap call per 25 words).
# Drops words that are not real base forms and clues that are wrong or unnatural.
VERIFY_ENTRIES="true"
# Hard cap on Gemini calls per UTC day (generation + judge). The free tier's daily
# request quota is the binding limit, not the per-minute one.
POOL_DAILY_CALL_BUDGET="300"
# Background top-up of the buckets players ask for.
# POOL_REFILL_ENABLED="true"
# POOL_REFILL_INTERVAL_MS="60000"
# POOL_REFILL_TARGET="300"
# POOL_REFILL_MAX_CALLS="2"

# --- Accounts ----------------------------------------------------------------
# Signs the session cookie. Generate once (`openssl rand -hex 64`) and keep it.
# Changing it signs everyone out. The dev default in code is local only.
# JWT_SECRET=""
# Google sign-in. Empty hides the button. The redirect URI must match Google Cloud.
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# GOOGLE_REDIRECT_URI="http://localhost:9007/identity/google/callback"
# Mail engine for verification and password links. Empty logs the link in the API
# terminal in development, and refuses to send in production.
# MAIL_API_URL=""
# MAIL_API_KEY=""

# --- Paddle (credit packs) ---------------------------------------------------
# docs/PADDLE_SETUP.md. Read only by src/lib/paddle.ts. Empty API key = the shop is
# closed (packs show list prices, checkout answers 503); free puzzles keep working.
# Sandbox and live have separate keys, secrets and price ids.
# PADDLE_API_KEY=""
# Signing secret of the notification destination. Comma-separated during a rotation.
# PADDLE_WEBHOOK_SECRET=""
# "true" = sandbox-api.paddle.com. Omit in production.
# PADDLE_SANDBOX="true"
# One one-time price per pack (src/lib/puzzle.ts CREDIT_PACKS).
# PADDLE_PRICE_ID_STARTER=""
# PADDLE_PRICE_ID_POPULAR=""
# PADDLE_PRICE_ID_BIG=""
# Guest devices one IP address may take a free puzzle for each month.
# GUEST_FREE_PER_IP="3"

# --- B. LOCAL DEV ONLY --------------------------------------------------------
# Defaults to 9007.
# PORT=9007
# HOST=127.0.0.1
# NODE_ENV is not set in these files: it is what picks the file (unset = development).
# "false" turns the per-IP rate limits off — only for e2e runs, where every test shares one IP.
# RATE_LIMIT_ENABLED="false"
# "false" builds every puzzle free — only for e2e runs (guests on one IP). Ignored in production.
# BILLING_ENABLED="false"

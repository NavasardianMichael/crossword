{
  "name": "crossword",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.25.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail -n web,api -c green,cyan \"pnpm dev:web\" \"pnpm server:dev\"",
    "dev:web": "next dev --turbopack --port 7007",
    "build": "next build",
    "start": "next start --port 7007",
    "lint": "eslint . --max-warnings 0",
    "lint-fix": "eslint . --fix",
    "lint-staged": "lint-staged",
    "typecheck": "tsc --noEmit",
    "typecheck:server": "pnpm --filter crossword-server exec tsc --noEmit",
    "gates": "node scripts/gates.mjs",
    "verify": "pnpm typecheck && pnpm typecheck:server && pnpm gates && pnpm lint && pnpm test && pnpm build",
    "test": "vitest run --project unit && vitest run --project integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:messages": "node scripts/check-messages.mjs",
    "i18n:sync": "node scripts/i18n-sync.mjs",
    "postinstall": "node scripts/postinstall.mjs",
    "prepare": "husky",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter crossword-server run db:deploy",
    "db:seed": "pnpm --filter crossword-server run db:seed",
    "db:setup": "pnpm db:migrate && pnpm db:seed",
    "server:dev": "pnpm --filter crossword-server dev",
    "build:api": "pnpm --filter crossword-server build && node scripts/build-api-release.mjs",
    "env:base64": "node scripts/env-to-base64.mjs"
  },
  "dependencies": {
    "@ant-design/nextjs-registry": "^1.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@sentry/nextjs": "^11.9.0",
    "antd": "^6.6.7",
    "axios": "^1.20.0",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "idb": "^8.0.4",
    "immer": "^11.2.9",
    "lucide-react": "^1.61.0",
    "motion": "^14.6.0",
    "next": "^16.4.3",
    "next-intl": "^4.14.9",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.4.3",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/supertest": "^7.2.1",
    "concurrently": "^10.0.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "prettier": "^3.9.6",
    "schema-dts": "^2.0.0",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs}": [
      "eslint --fix --no-warn-ignored"
    ]
  }
}

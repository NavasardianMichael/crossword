# =============================================================================
# Web app (Next.js). Copy to .env.local for local dev. Every NEXT_PUBLIC_* value
# is inlined into the browser bundle at build time — public by construction.
# The API has its own file: server/.env.example.
# =============================================================================

# Where the browser reaches the API. Production: https://api.<your domain>
NEXT_PUBLIC_API_URL="http://localhost:9007"

# The canonical origin: metadata, hreflang, sitemap and share links are built from it.
# Production: https://<your domain> — must equal the API's CORS_ORIGIN.
NEXT_PUBLIC_SITE_URL="http://localhost:7007"

# Server-side only: lets server-rendered pages reach the API over loopback in
# production (set by the systemd unit). Leave unset in dev.
# API_INTERNAL_URL="http://127.0.0.1:9007"

# Google Analytics 4 Measurement ID (G-XXXXXXXX). Empty = analytics off.
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# Search Console verification token, emitted as <meta name="google-site-verification">.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""

# Sentry. Empty DSN = error tracking off. The other three are CI-only, for
# uploading source maps.
NEXT_PUBLIC_SENTRY_DSN=""
# SENTRY_ORG=""
# SENTRY_PROJECT=""
# SENTRY_AUTH_TOKEN=""
